source "https://rubygems.org"

gem "jekyll", "~> 4.4"

# Keep rouge 3.x: 4.x emits different token classes than the ones styled in assets/css/syntax-highlight.css
gem "rouge", "~> 3.30"

# Needed by `jekyll serve` on Ruby >= 3.0
gem "webrick", "~> 1.9"

# Some distros (e.g. Arch) don't ship erb with ruby, jekyll needs it
gem "erb"
